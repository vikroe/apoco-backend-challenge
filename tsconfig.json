{
    "extends": "@tsconfig/node24/tsconfig.json",

    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./build",
        "types": ["node"],
        "declaration": true,
        "experimentalDecorators": true
    },
    "include": ["src/**/*.ts"],
    "exclude": [
        "./build",
        "./node_modules",
        "src/**/*.test.ts",
        "src/**/*.spec.ts",
        "test/**/*.ts"
    ]
}
